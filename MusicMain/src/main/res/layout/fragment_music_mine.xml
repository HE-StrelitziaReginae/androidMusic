<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="musicMineModel"
            type="com.artillery.musicmain.viewmodel.MusicMineViewModel" />
    </data>

    <ScrollView
        android:id="@+id/music_mine_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:id="@+id/music_mine_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_12">

            <FrameLayout
                android:id="@+id/music_mine_skin_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_168"
                android:clipToOutline="true"
                android:elevation="@dimen/dp_6">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_mine_skin_banner_art"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:alpha="0.78"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/skin_sakura_key_art_v3" />

                <View
                    android:id="@+id/music_mine_skin_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/music_banner_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="@string/music_mine_default_eyebrow"
                        android:textSize="@dimen/sp_10"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="@string/music_mine_default_title"
                        android:textSize="@dimen/sp_21"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_subtitle"
                        android:layout_width="@dimen/dp_190"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:maxLines="2"
                        android:text="@string/music_mine_default_subtitle"
                        android:textSize="@dimen/sp_11" />

                </LinearLayout>
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/music_mine_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                android:layout_marginStart="@dimen/dp_4"
                android:letterSpacing="0.1"
                android:text="@string/music_mine_quick_access"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/music_mine_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_mine_favorites"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_92"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="@drawable/music_ripple_rounded_18"
                    android:gravity="center"
                    android:text="@string/music_mine_favorites"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/music_mine_local_tracks"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_92"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="@drawable/music_ripple_rounded_18"
                    android:gravity="center"
                    android:text="@string/music_mine_local_tracks"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/music_mine_playlists"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_92"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="@drawable/music_ripple_rounded_18"
                    android:gravity="center"
                    android:text="@string/music_mine_playlists"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/music_mine_empty_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_190"
                android:layout_marginTop="@dimen/dp_14"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="@drawable/music_ripple_rounded_18"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/dp_20">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_mine_empty_icon"
                    android:layout_width="@dimen/dp_68"
                    android:layout_height="@dimen/dp_68"
                    android:background="@drawable/music_toolbar_mascot_background"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:outlineProvider="background"
                    android:padding="@dimen/dp_18"
                    android:src="@drawable/music_player" />

                <TextView
                    android:id="@+id/music_mine_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/music_mine_empty_title"
                    android:textSize="@dimen/sp_17"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/music_mine_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:gravity="center"
                    android:text="@string/music_mine_empty_message"
                    android:textSize="@dimen/sp_11" />

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</layout>
