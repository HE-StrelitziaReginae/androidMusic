<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="com.artillery.musicmain.viewmodel.MusicMineViewModel" />

        <variable
            name="musicMineModel"
            type="com.artillery.musicmain.viewmodel.MusicMineViewModel" />
    </data>

    <ScrollView
        android:id="@+id/music_mine_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:id="@+id/music_mine_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_12">

            <FrameLayout
                android:id="@+id/music_mine_skin_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_156"
                android:clipToOutline="true"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_mine_skin_banner_art"
                    android:layout_width="@dimen/dp_190"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/skin_sakura_key_art" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/music_banner_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="@string/music_character_mine_eyebrow"
                        android:textSize="@dimen/sp_10"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="@string/music_character_mine_title"
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/music_mine_skin_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/music_character_mine_subtitle"
                        android:textSize="@dimen/sp_11" />

                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/music_mine_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_mine_favorites"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_82"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/music_mine_favorites"
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:id="@+id/music_mine_local_tracks"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_82"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/music_mine_local_tracks"
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:id="@+id/music_mine_playlists"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_82"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/music_mine_playlists"
                    android:textSize="@dimen/sp_13" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/music_mine_empty_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_180"
                android:layout_marginTop="@dimen/dp_12"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_mine_empty_icon"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:contentDescription="@null"
                    android:src="@drawable/music_player" />

                <TextView
                    android:id="@+id/music_mine_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/music_mine_empty_title"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/music_mine_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/music_mine_empty_message"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</layout>
