<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/music_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_character_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleX="1.12"
            android:scaleY="1.12"
            android:scaleType="centerCrop"
            android:src="@drawable/skin_sakura_key_art"
            android:visibility="gone" />

        <View
            android:id="@+id/music_character_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/music_character_scrim"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/music_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <FrameLayout
            android:id="@+id/music_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/music_now_playing_badge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="@dimen/dp_32"
                android:background="@drawable/music_player_panel"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16">

                <View
                    android:id="@+id/music_now_playing_indicator"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:background="@drawable/music_disc_spindle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_now_playing_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:letterSpacing="0.14"
                    android:text="@string/music_now_playing"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/music_dialog_close"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_gravity="end|top"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_12"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_dialog_close"
                android:padding="@dimen/dp_12"
                android:src="@drawable/music_close" />

            <FrameLayout
                android:id="@+id/music_album_card"
                android:layout_width="@dimen/dp_232"
                android:layout_height="@dimen/dp_232"
                android:layout_gravity="center"
                android:background="@drawable/music_album_disc"
                android:clickable="true"
                android:contentDescription="@string/music_album_toggle"
                android:elevation="@dimen/dp_20"
                android:focusable="true"
                android:padding="@dimen/dp_8">

                <FrameLayout
                    android:id="@+id/music_album_stage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/music_album_disc"
                    android:clipToOutline="true">

                    <FrameLayout
                        android:id="@+id/music_disc_rotate_group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/music_album_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ellipse" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/music_album_grooves"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/music_album_grooves" />

                        <FrameLayout
                            android:id="@+id/music_album_spindle"
                            android:layout_width="@dimen/dp_28"
                            android:layout_height="@dimen/dp_28"
                            android:layout_gravity="center"
                            android:padding="@dimen/dp_8">

                            <View
                                android:id="@+id/music_album_spindle_dot"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/music_disc_spindle" />

                        </FrameLayout>

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/music_lyrics_page"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_24"
                        android:visibility="gone">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/music_lyrics_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.18"
                            android:text="@string/music_lyrics_title"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/music_lyrics_song"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_14"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/music_not_play"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/music_lyrics_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="@string/music_lyrics_empty"
                            android:textSize="@dimen/sp_12" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/music_lyrics_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:text="@string/music_lyrics_hint"
                            android:textSize="@dimen/sp_10" />

                    </LinearLayout>

                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/music_dialog_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_8"
            android:elevation="@dimen/dp_8"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_24"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/music_character_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/dp_6"
                android:letterSpacing="0.12"
                android:text="@string/music_character_badge"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/music_character_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/dp_8"
                android:text="@string/music_character_name"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/music_briefly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_name_play"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:freezesText="true"
                    android:gravity="center_horizontal"
                    android:letterSpacing="0.01"
                    android:lines="1"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="@string/music_not_play"
                    android:textSize="@dimen/sp_20"
                    app:layout_constraintBottom_toTopOf="@id/music_artist_play"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_artist_play"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/music_unknown"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/music_name_play"
                    app:layout_constraintVertical_chainStyle="packed" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/music_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">

                <SeekBar
                    android:id="@+id/music_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:background="@null"
                    android:maxHeight="@dimen/dp_5"
                    android:progress="0"
                    android:progressDrawable="@drawable/music_seekbar_progress"
                    android:thumb="@null"
                    android:thumbOffset="@dimen/dp_0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/music_time_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="@string/music_time"
                    android:textSize="@dimen/sp_12"
                    android:fontFamily="monospace"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/music_seekbar" />

                <TextView
                    android:id="@+id/music_time_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:text="@string/music_time"
                    android:textSize="@dimen/sp_12"
                    android:fontFamily="monospace"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/music_seekbar" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/music_action_liner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_18"
                android:layout_marginBottom="@dimen/dp_8"
                android:background="@drawable/music_player_panel"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_pre_btn"
                    style="@style/CustomButtonRipple"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:contentDescription="@string/music_pre"
                    android:src="@drawable/previous" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_play_btn"
                    style="@style/CustomButtonRipple"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:layout_marginStart="@dimen/dp_32"
                    android:layout_marginEnd="@dimen/dp_32"
                    android:background="@drawable/music_play_button_background"
                    android:contentDescription="@string/music_play"
                    android:src="@drawable/play" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_next_btn"
                    style="@style/CustomButtonRipple"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:contentDescription="@string/music_next"
                    android:src="@drawable/next" />

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</layout>
