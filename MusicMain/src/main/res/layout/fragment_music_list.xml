<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.artillery.musicmain.viewmodel.MusicListViewModel" />

        <import type="com.artillery.musicbase.binding.viewadapter.recyclerview.LayoutManagers" />

        <import type="com.artillery.musicbase.binding.viewadapter.recyclerview.LineManagers" />

        <variable
            name="musicListModel"
            type="com.artillery.musicmain.viewmodel.MusicListViewModel" />

    </data>

    <LinearLayout
        android:id="@+id/music_list_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/music_skin_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_132"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_12"
            android:clipToOutline="true"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/music_skin_banner_art"
                android:layout_width="@dimen/dp_160"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:alpha="0.68"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/skin_sakura_key_art" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/music_banner_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_18"
                android:paddingEnd="@dimen/dp_18">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_skin_banner_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/music_character_music_eyebrow"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_skin_banner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/music_character_music_title"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_skin_banner_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/music_character_music_subtitle"
                    android:textSize="@dimen/sp_11" />

            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/music_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:itemBinding="@{musicListModel.musicListBinding}"
            binding:items="@{musicListModel.musicListItem}"
            binding:layoutManager="@{LayoutManagers.linear()}"
            binding:lineManager="@{LineManagers.horizontal()}" />

    </LinearLayout>

</layout>
