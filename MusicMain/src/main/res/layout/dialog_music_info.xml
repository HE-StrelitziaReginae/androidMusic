<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_24"
    android:paddingTop="@dimen/dp_28"
    android:paddingEnd="@dimen/dp_24"
    android:paddingBottom="@dimen/dp_8">

    <FrameLayout
        android:id="@+id/dialog_info_icon_container"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:padding="@dimen/dp_16">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dialog_info_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dialog_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:gravity="center"
        android:textColor="@color/music_text_primary"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dialog_info_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dp_4"
        android:textColor="@color/music_text_secondary"
        android:textSize="@dimen/sp_14" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dialog_info_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:gravity="center"
        android:paddingStart="@dimen/dp_14"
        android:paddingTop="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_6"
        android:textColor="@color/music_text_secondary"
        android:textSize="@dimen/sp_12" />

</LinearLayout>
