<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:binding="http://schemas.android.com/tools">

    <data>

        <import type="com.artillery.musicmain.viewmodel.MusicMainViewModel" />

        <variable
            name="musicMainModel"
            type="MusicMainViewModel" />
    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/music_drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/music_toolbar_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/music_toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:background="@color/music_toolbar_background"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_16">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/music_menu_btn"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/music_menu"
                    android:padding="@dimen/dp_12"
                    android:src="@drawable/music_menu" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/music_toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/music_app_name"
                    android:textColor="@color/music_text_primary"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/music_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/music_show_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8"
                binding:onClickCommand="@{musicMainModel.mShow}"
                android:layout_gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/music_album_img"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:layout_marginStart="@dimen/dp_10"
                android:src="@drawable/ellipse"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/music_name_play"
                android:layout_width="@dimen/dp_80"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_10"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:freezesText="true"
                android:lines="1"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="@string/music_not_play"
                android:textSize="@dimen/sp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/music_album_img"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/music_line"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_1"
                android:layout_marginStart="@dimen/dp_5"
                android:background="@color/grey"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/music_name_play"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/music_artist_play"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_5"
                android:text="@string/music_unknown"
                android:textSize="@dimen/sp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/music_line"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/music_play_btn"
                style="@style/CustomButtonRipple"
                android:layout_width="@dimen/dp_45"
                android:layout_height="@dimen/dp_45"
                android:layout_marginEnd="@dimen/dp_20"
                android:src="@drawable/play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                binding:onClickCommand="@{musicMainModel.mPlay}" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RadioGroup
                android:id="@+id/music_group"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_4"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_4">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/music_main"
                style="@style/CustomRadioButton"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_52"
                android:layout_marginEnd="@dimen/dp_2"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"
                 android:drawableTop="@drawable/music_tab_home"
                 android:drawablePadding="@dimen/dp_2"
                android:text="@string/music_home_tab" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/music_online"
                style="@style/CustomRadioButton"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_52"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_2"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"
                 android:drawableTop="@drawable/music_tab_online"
                 android:drawablePadding="@dimen/dp_2"
                android:text="@string/music_online_tab" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/music_mine"
                style="@style/CustomRadioButton"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_52"
                android:layout_marginStart="@dimen/dp_2"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"
                 android:drawableTop="@drawable/music_tab_mine"
                 android:drawablePadding="@dimen/dp_2"
                android:text="@string/music_mine_tab" />

            </RadioGroup>

        </LinearLayout>

        <ScrollView
            android:id="@+id/music_drawer_panel"
            android:layout_width="@dimen/dp_320"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/music_drawer_background"
            android:elevation="@dimen/dp_16"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp_24">

                <FrameLayout
                    android:id="@+id/drawer_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/music_drawer_header"
                    android:minHeight="@dimen/dp_220">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/drawer_character_art"
                        android:layout_width="@dimen/dp_176"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:alpha="0.72"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/skin_sakura_key_art"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/drawer_character_scrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/music_drawer_character_scrim"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/dp_28"
                        android:paddingTop="@dimen/dp_36"
                        android:paddingEnd="@dimen/dp_28"
                        android:paddingBottom="@dimen/dp_28">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/drawer_avatar"
                        android:layout_width="@dimen/dp_76"
                        android:layout_height="@dimen/dp_76"
                        android:background="@drawable/drawer_avatar_ring"
                        android:padding="@dimen/dp_3"
                        android:clipToOutline="true"
                        android:contentDescription="@string/music_profile_avatar"
                        android:src="@drawable/ellipse" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:text="@string/music_profile_name"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_profile_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/music_profile_subtitle"
                        android:textColor="@color/music_drawer_header_text_secondary"
                        android:textSize="@dimen/sp_12" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_profile_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/music_profile_hint"
                        android:textColor="@color/music_drawer_header_text_secondary"
                        android:textSize="@dimen/sp_10" />

                    </LinearLayout>

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/drawer_library_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_28"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:letterSpacing="0.12"
                    android:text="@string/music_section_library"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/drawer_refresh"
                    style="@style/MusicDrawerItem"
                    android:contentDescription="@string/music_refresh_library">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_refresh" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_refresh_text"
                        style="@style/MusicDrawerItemText"
                        android:text="@string/music_refresh_library" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/drawer_player_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_28"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:letterSpacing="0.12"
                    android:text="@string/music_section_player"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/drawer_play_mode"
                    style="@style/MusicDrawerItem"
                    android:contentDescription="@string/music_play_mode">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_mode" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/drawer_play_mode_text"
                            style="@style/MusicDrawerItemText"
                            android:text="@string/music_play_mode" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/drawer_play_mode_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:textColor="@color/music_text_secondary"
                            android:textSize="@dimen/sp_12" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerTrailingIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_chevron_right" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_skin"
                    style="@style/MusicDrawerItem"
                    android:contentDescription="@string/music_skin">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_skin" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_skin_text"
                        style="@style/MusicDrawerItemText"
                        android:text="@string/music_skin" />

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerTrailingIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_chevron_right" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_about"
                    style="@style/MusicDrawerItem"
                    android:contentDescription="@string/music_about">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/MusicDrawerIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/music_info" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/drawer_about_text"
                        style="@style/MusicDrawerItemText"
                        android:text="@string/music_about" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>
