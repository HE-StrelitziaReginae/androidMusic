<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/music_skin_seekbar_radius" />
            <solid android:color="@color/black" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="@dimen/music_skin_seekbar_radius" />
                <gradient
                    android:centerColor="@color/music_seekbar_center"
                    android:endColor="@color/music_seekbar_end"
                    android:startColor="@color/music_seekbar_start"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
